{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/tsconfig.*.json"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["ARCADE_SITE_URL"]
    },
    "@arcade/site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/games/*/game.json"],
      "env": ["ARCADE_INCLUDE"]
    },
    "@arcade/cli#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/tools/**",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/templates/**",
        "$TURBO_ROOT$/games/**",
        "$TURBO_ROOT$/docs/**",
        "$TURBO_ROOT$/.claude/**",
        "$TURBO_ROOT$/.github/**",
        "$TURBO_ROOT$/biome.json",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/.wrangler/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/.claude/worktrees/**"
      ]
    }
  }
}
