{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/config/tsconfig.*.json"]
    },
    "test": {
      "dependsOn": ["^typecheck"],
      "inputs": ["$TURBO_DEFAULT$"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["ARCADE_SITE_URL"]
    },
    "@arcade/site#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/games/*/game.json"],
      "env": ["ARCADE_INCLUDE"]
    },
    "@arcade/cli#test": {
      "dependsOn": ["^typecheck"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/docs/repo-map.md",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/tools/*/src/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/templates/*/src/**",
        "$TURBO_ROOT$/templates/*/scenarios/**"
      ]
    }
  }
}
