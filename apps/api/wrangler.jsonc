{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // The room service for online races (plans/reef-rush-multiplayer.md, section 5.5). It has no public
  // route: the site Worker forwards /api/* to it through a service binding (root wrangler.jsonc), so
  // browsers only ever reach it same-origin. Deploy by hand with `pnpm deploy:api`; a deploy drops
  // every open room.
  "name": "arcade-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "durable_objects": { "bindings": [{ "name": "ROOM", "class_name": "Room" }] },
  // SQLite-backed, the only kind of Durable Object the free plan allows.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room"] }]
}
