{
  "name": "game-rush-racers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.logic.json",
    "test": "vitest run --project unit",
    "test:difficulty": "vitest run --project difficulty",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@arcade/api": "workspace:*",
    "@arcade/core": "workspace:*",
    "@arcade/input": "workspace:*",
    "@arcade/save": "workspace:*",
    "@arcade/shell": "workspace:*",
    "phaser": "4.2.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@arcade/config": "workspace:*",
    "@arcade/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "fake-indexeddb": "catalog:"
  },
  "arcade": {
    "attract": {
      "scenario": "race-to-finish",
      "from": 150,
      "to": 1050,
      "every": 3,
      "cover": 1500
    },
    "testGroups": {
      "behavior": [
        "src/engine/audio/sfx-pin.test.ts"
      ],
      "seams": [
        "src/logic/architecture.test.ts",
        "src/logic/media/boundary.test.ts",
        "src/engine/themes"
      ],
      "courses": [
        "src/logic/courses",
        "src/logic/conformance/course.test.ts",
        "src/logic/level",
        "src/logic/difficulty-level.test.ts",
        "src/logic/difficulty/sanity"
      ],
      "media": [
        "src/logic/media",
        "src/logic/conformance/medium.test.ts",
        "src/logic/ai"
      ],
      "saves": [
        "tests/save.test.ts",
        "src/logic/records.test.ts",
        "src/logic/courses/index.test.ts"
      ],
      "engine": [
        "src/engine"
      ],
      "bars": [
        "src/logic/difficulty/"
      ],
      "platform": [
        "src/logic/race/move-contacts.test.ts",
        "src/logic/race/ledge.test.ts",
        "src/logic/race/pit.test.ts",
        "src/logic/hazards/enemies/stomp.test.ts",
        "src/logic/pickups/crates.test.ts",
        "src/logic/conformance/seams.test.ts"
      ],
      "worlds": [
        "src/engine/worlds",
        "src/logic/worlds"
      ]
    }
  }
}
