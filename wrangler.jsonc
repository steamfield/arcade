{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Assets-only Worker: no script, so every request is a free static asset request.
  // Add "main" and run_worker_first: ["/api/*"] only when a game needs a backend (see docs/architecture.md).
  // Cloudflare Workers Builds (the Git connector) runs `pnpm cf:build` then `npx wrangler deploy`.
  "name": "arcade",
  "compatibility_date": "2026-11-01",
  // Custom domain: the first deploy creates the DNS record and certificate in the steamfield.io zone.
  // Saves live in IndexedDB scoped to this origin, so don't change it once players have saves.
  "routes": [{ "pattern": "arcade.steamfield.io", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  }
}
