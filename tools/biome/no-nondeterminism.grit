// Game logic must be deterministic: same seed + same input = same state.
or {
  `Math.random()` as $call where {
    register_diagnostic(span=$call, message="Math.random() makes logic non-deterministic. Use the seeded rng from createRng() in @arcade/core.", severity="error")
  },
  `Date.now()` as $call where {
    register_diagnostic(span=$call, message="Logic must not read the clock. Use the dt and tick passed to your step function.", severity="error")
  },
  `new Date()` as $call where {
    register_diagnostic(span=$call, message="Logic must not read the clock. Use the dt and tick passed to your step function.", severity="error")
  }
}
