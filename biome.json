{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/.turbo",
      "!**/test-results",
      "!**/.arcade",
      "!**/*.gen.ts",
      "!**/*.md",
      "!.claude/worktrees"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "linter": {
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noTsIgnore": "error"
      },
      "nursery": {
        "noFloatingPromises": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.spec.ts", "**/scenarios/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noSkippedTests": "error",
            "noFocusedTests": "error"
          }
        }
      }
    },
    {
      "includes": ["games/**/src/**", "templates/**/src/**", "packages/*/src/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": {
              "level": "error",
              "options": {
                "allow": []
              }
            }
          }
        }
      }
    },
    {
      "includes": ["games/**/src/**", "templates/**/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedGlobals": {
              "level": "error",
              "options": {
                "deniedGlobals": {
                  "localStorage": "Use @arcade/save: it namespaces saves per game and handles eviction.",
                  "sessionStorage": "Use @arcade/save: it namespaces saves per game and handles eviction.",
                  "indexedDB": "Use @arcade/save: it namespaces saves per game and handles eviction."
                }
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@arcade/*/src/*", "@arcade/*/src"],
                    "message": "Import from the package entry (@arcade/<pkg>), not its internals."
                  },
                  {
                    "group": ["../../games/*", "../../../games/*", "../../templates/*"],
                    "message": "Games never import other games. Move shared code into a package."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["games/**/src/logic/**", "templates/**/src/logic/**"],
      "plugins": ["./tools/biome/no-nondeterminism.grit"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "error",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "phaser": "Logic must be engine-free so it can be unit tested. Rendering goes in src/engine/.",
                  "three": "Logic must be engine-free so it can be unit tested. Rendering goes in src/engine/.",
                  "@dimforge/rapier3d-compat": "Physics engines belong in src/engine/. Logic gets results passed in.",
                  "@arcade/shell": "Logic may import only @arcade/core and zod.",
                  "@arcade/save": "Logic may import only @arcade/core and zod. Save types are in @arcade/core.",
                  "@arcade/input": "Logic may import only @arcade/core and zod. Pass input state in as plain data."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["games/rush-racers/src/logic/**", "!**/*.test.ts"],
      "plugins": ["./tools/biome/no-inexact-math.grit"]
    }
  ]
}
